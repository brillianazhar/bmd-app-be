model AuthGroup {
  id                   Int                    @id(map: "auth_group_pkey") @default(autoincrement())
  name                 VarChar(150)           @unique(map: "auth_group_name_key")
  authGroupPermissions AuthGroupPermissions[]
  authUserGroups       AuthUserGroups[]

  @@index([name], map: "auth_group_name_a6ea08ec_like")
  @@map("auth_group")
}

model DjangoContentType {
  id              Int              @id(map: "django_content_type_pkey") @default(autoincrement())
  appLabel        VarChar(100)     @map("app_label")
  _model          VarChar(100)     @map("model")
  authPermissions AuthPermission[]
  djangoAdminLogs DjangoAdminLog[]

  @@unique([appLabel, _model], map: "django_content_type_app_label_model_76bd3d3b_uniq")
  @@map("django_content_type")
}

model AuthPermission {
  id                      Int                       @id(map: "auth_permission_pkey") @default(autoincrement())
  name                    VarChar(255)
  contentTypeId           Int                       @map("content_type_id")
  codename                VarChar(100)
  authGroupPermissions    AuthGroupPermissions[]
  authUserUserPermissions AuthUserUserPermissions[]
  contentType             DjangoContentType         @relation(fields: [contentTypeId], references: [id], map: "auth_permission_content_type_id_2f476e4b_fk_django_co")

  @@unique([contentTypeId, codename], map: "auth_permission_content_type_id_codename_01ab375a_uniq")
  @@index([contentTypeId], map: "auth_permission_content_type_id_2f476e4b")
  @@map("auth_permission")
}

model AuthGroupPermissions {
  id           BigInt         @id(map: "auth_group_permissions_pkey") @default(autoincrement())
  groupId      Int            @map("group_id")
  permissionId Int            @map("permission_id")
  permission   AuthPermission @relation(fields: [permissionId], references: [id], map: "auth_group_permissio_permission_id_84c5c92e_fk_auth_perm")
  group        AuthGroup      @relation(fields: [groupId], references: [id], map: "auth_group_permissions_group_id_b120cbf9_fk_auth_group_id")

  @@unique([groupId, permissionId], map: "auth_group_permissions_group_id_permission_id_0cd325b0_uniq")
  @@index([groupId], map: "auth_group_permissions_group_id_b120cbf9")
  @@index([permissionId], map: "auth_group_permissions_permission_id_84c5c92e")
  @@map("auth_group_permissions")
}

model AuthUser {
  id                      Int                       @id(map: "auth_user_pkey") @default(autoincrement())
  password                VarChar(128)
  lastLogin               TimestamptzString?        @map("last_login")
  isSuperuser             Boolean                   @map("is_superuser")
  username                VarChar(150)              @unique(map: "auth_user_username_key")
  firstName               VarChar(150)              @map("first_name")
  lastName                VarChar(150)              @map("last_name")
  email                   VarChar(254)
  isStaff                 Boolean                   @map("is_staff")
  isActive                Boolean                   @map("is_active")
  dateJoined              TimestamptzString         @map("date_joined")
  authUserGroups          AuthUserGroups[]
  authUserUserPermissions AuthUserUserPermissions[]
  djangoAdminLogs         DjangoAdminLog[]

  @@index([username], map: "auth_user_username_6821ab7c_like")
  @@map("auth_user")
}

model AuthUserGroups {
  id      BigInt    @id(map: "auth_user_groups_pkey") @default(autoincrement())
  userId  Int       @map("user_id")
  groupId Int       @map("group_id")
  group   AuthGroup @relation(fields: [groupId], references: [id], map: "auth_user_groups_group_id_97559544_fk_auth_group_id")
  user    AuthUser  @relation(fields: [userId], references: [id], map: "auth_user_groups_user_id_6a12ed8b_fk_auth_user_id")

  @@unique([userId, groupId], map: "auth_user_groups_user_id_group_id_94350c0c_uniq")
  @@index([groupId], map: "auth_user_groups_group_id_97559544")
  @@index([userId], map: "auth_user_groups_user_id_6a12ed8b")
  @@map("auth_user_groups")
}

model AuthUserUserPermissions {
  id           BigInt         @id(map: "auth_user_user_permissions_pkey") @default(autoincrement())
  userId       Int            @map("user_id")
  permissionId Int            @map("permission_id")
  permission   AuthPermission @relation(fields: [permissionId], references: [id], map: "auth_user_user_permi_permission_id_1fbb5f2c_fk_auth_perm")
  user         AuthUser       @relation(fields: [userId], references: [id], map: "auth_user_user_permissions_user_id_a95ead1b_fk_auth_user_id")

  @@unique([userId, permissionId], map: "auth_user_user_permissions_user_id_permission_id_14a6b632_uniq")
  @@index([permissionId], map: "auth_user_user_permissions_permission_id_1fbb5f2c")
  @@index([userId], map: "auth_user_user_permissions_user_id_a95ead1b")
  @@map("auth_user_user_permissions")
}

model DjangoAdminLog {
  id            Int                @id(map: "django_admin_log_pkey") @default(autoincrement())
  actionTime    TimestamptzString  @map("action_time")
  objectId      String?            @map("object_id")
  objectRepr    VarChar(200)       @map("object_repr")
  actionFlag    SmallInt           @map("action_flag")
  changeMessage String             @map("change_message")
  contentTypeId Int?               @map("content_type_id")
  userId        Int                @map("user_id")
  contentType   DjangoContentType? @relation(fields: [contentTypeId], references: [id], map: "django_admin_log_content_type_id_c4bce8eb_fk_django_co")
  user          AuthUser           @relation(fields: [userId], references: [id], map: "django_admin_log_user_id_c564eba6_fk_auth_user_id")

  @@index([contentTypeId], map: "django_admin_log_content_type_id_c4bce8eb")
  @@index([userId], map: "django_admin_log_user_id_c564eba6")
  @@check(expression: "(action_flag >= 0)", map: "django_admin_log_action_flag_check")
  @@map("django_admin_log")
}

model DjangoMigrations {
